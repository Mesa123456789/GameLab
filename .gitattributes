# Auto-detect text files and normalize line endings
* text=auto

# Unreal C++, C#, Config, and Project files
*.h text
*.hpp text
*.c text
*.cpp text
*.inl text
*.cs text
*.ini text
*.uproject text
*.uplugin text
*.json text
*.md text
*.txt text
.editorconfig text
.gitattributes text
.gitignore text

# Scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

# === Git LFS: Unreal Binary Assets (no lockable to keep BP files writable) ===
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.uptnl filter=lfs diff=lfs merge=lfs -text

